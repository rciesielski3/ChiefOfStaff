{
  "name": "chief-of-staff",
  "version": "1.0.0",
  "description": "Personal AI Chief of Staff: daily brief, knowledge extraction and QA News export",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint . --max-warnings=78",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test -- --coverage",
    "test": "jest",
    "test:watch": "jest --watch",
    "daily-brief": "ts-node src/cli/daily-brief.ts",
    "evolve-knowledge": "ts-node src/scripts/evolve-knowledge.ts"
  },
  "keywords": [
    "chief-of-staff",
    "daily-brief",
    "knowledge-extraction"
  ],
  "author": "Rafal Ciesielski",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "proper-lockfile": "^4.1.2",
    "rss-parser": "^3.13.0"
  }
}
