{
  "name": "paios-typescript",
  "version": "1.0.0",
  "description": "PAIOS business logic extracted to TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test -- --coverage",
    "test": "jest",
    "test:watch": "jest --watch",
    "daily-brief": "ts-node src/cli/daily-brief.ts",
    "evolve-knowledge": "ts-node src/scripts/evolve-knowledge.ts"
  },
  "keywords": [
    "paios",
    "business-logic",
    "daily-brief"
  ],
  "author": "Rafal Ciesielski",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "proper-lockfile": "^4.1.2",
    "rss-parser": "^3.13.0"
  }
}
