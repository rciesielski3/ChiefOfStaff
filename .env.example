# ChiefofStaff environment template
# Copy to .env and fill in real values. Never commit .env.
# Variables below are the ones read by src/ and the GitHub Actions workflows.

# --- Required for LLM features (knowledge extraction, insights, summaries) ---
ANTHROPIC_API_KEY=

# Optional: override the default model (default: claude-haiku-4-5)
# CLAUDE_MODEL=

# --- Telegram delivery (used by workflows as secrets; optional locally) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional overrides (defaults shown) ---
# CHIEF_OF_STAFF_ROOT=            # project root; defaults to the repo directory
# BRIEF_COUNT=10                  # articles in the daily brief
# EXTRACT_COUNT=20                # articles per knowledge-extraction run
# ARTICLES_PATH=data/canonical_articles.ndjson
# KNOWLEDGE_FACTS_PATH=data/knowledge_facts.ndjson
# INSIGHTS_PATH=data/insights.ndjson
# CLASSIFIER_CACHE_PATH=data/classifier-cache.json
# INPUT_FACTS=data/knowledge_facts.ndjson
# OUTPUT_FACTS=data/knowledge_facts.ndjson
# EMBEDDINGS_CACHE=data/fact_embeddings.ndjson
